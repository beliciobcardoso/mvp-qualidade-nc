generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PhotoAnalisys {
  id          Int    @id @default(autoincrement())
  idReport    Int
  url         String
  name        String
  description String
  index       Int
  report      Report @relation(fields: [idReport], references: [id])
}

model DescriptionAnalisys {
  id       Int    @id @default(autoincrement())
  idReport Int
  service  String
  status   String
  report   Report @relation(fields: [idReport], references: [id])
}

model Report {
  id                  Int                   @id @default(autoincrement())
  dateService         DateTime
  createdAt           DateTime              @default(now())
  updatedAt           DateTime?
  finishedAt          DateTime?
  technicianId        String
  userId              String
  siteId              Int
  analystId           String?
  scopeServiceId      Int                   @default(1)
  descriptionAnalisys DescriptionAnalisys[]
  photoAnalisys       PhotoAnalisys[]
  analyst             User?                 @relation("ANALYST", fields: [analystId], references: [id])
  scopeService        ScopeService          @relation(fields: [scopeServiceId], references: [id])
  sites               Site                  @relation(fields: [siteId], references: [id])
  technician          Technician            @relation(fields: [technicianId], references: [id])
  user                User                  @relation(fields: [userId], references: [id])
}

model Site {
  id              Int           @id @default(autoincrement())
  idSite          String        @unique
  altura          String?
  endereco        String
  bairro          String
  numero          String
  cidade          String
  uf              String
  structureTypeId Int
  idClient        String
  siteTypeId      Int
  Report          Report[]
  client          Client        @relation(fields: [idClient], references: [id])
  siteType        SiteType      @relation(fields: [siteTypeId], references: [id])
  structureType   StructureType @relation(fields: [structureTypeId], references: [id])
}

model ScopeService {
  id      Int      @id @default(autoincrement())
  name    String
  reports Report[]
}

model Client {
  id   String  @id @default(cuid())
  name String
  img  String?
  site Site[]
}

model SiteType {
  id    Int    @id @default(autoincrement())
  name  String
  sites Site[]
}

model StructureType {
  id    Int    @id @default(autoincrement())
  name  String
  sites Site[]
}

model Technician {
  id      String   @id @default(cuid())
  name    String
  reports Report[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  role         Role
  avatar       String?
  analyst      Report[]  @relation("ANALYST")
  Report       Report[]
  checkin      Checkin[]
}

enum Role {
  ADMIN
  USER
  ANALYST
  TECHNICIAN
  COORDINATOR
}

model PhotoCheckIn {
  id          Int     @id @default(autoincrement())
  checkin     Checkin @relation(fields: [idCheckIn], references: [id])
  idCheckIn   Int
  url         String
  name        String
  index       Int
  description String
}

model Provider {
  id      String    @id @default(cuid())
  name    String
  checkin Checkin[]
}

model Checkin {
  id                 Int                  @id @default(autoincrement())
  createdAt          DateTime             @default(now())
  dateCheckIn        DateTime
  user               User                 @relation(fields: [userId], references: [id])
  userId             String
  provider           Provider             @relation(fields: [providerId], references: [id])
  providerId         String
  descriptionCheckIn DescriptionCheckIn[]
  photoCheckIn       PhotoCheckIn[]
}

model DescriptionCheckIn {
  id          Int     @id @default(autoincrement())
  checkin     Checkin @relation(fields: [checkinId], references: [id])
  checkinId   Int
  description String
}
